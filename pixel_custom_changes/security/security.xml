<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

		<record model="res.groups.privilege" id="res_groups_privilege_departments">
			<field name="name">Departments</field>
			<field name="sequence">3</field>
		</record>

        <record id="group_department_devops" model="res.groups">
            <field name="name">IT</field>
			<field name="sequence">10</field>
			<field name="privilege_id" ref="res_groups_privilege_departments"/>
        </record>
        <record id="group_department_marketing" model="res.groups">
            <field name="name">Marketing</field>
			<field name="sequence">20</field>
        	<field name="implied_ids" eval="[(4, ref('pixel_custom_changes.group_department_devops'))]"/>
			<field name="privilege_id" ref="res_groups_privilege_departments"/>
        </record>
        <record id="group_department_finance" model="res.groups">
            <field name="name">Finance</field>
			<field name="sequence">30</field>
        	<field name="implied_ids" eval="[(4, ref('pixel_custom_changes.group_department_marketing'))]"/>
			<field name="privilege_id" ref="res_groups_privilege_departments"/>
        </record>
        <record id="group_department_business" model="res.groups">
            <field name="name">Business</field>
			<field name="sequence">40</field>
        	<field name="implied_ids" eval="[(4, ref('pixel_custom_changes.group_department_finance'))]"/>
			<field name="privilege_id" ref="res_groups_privilege_departments"/>
        </record>
        <record id="group_department_admin" model="res.groups">
            <field name="name">Admin</field>
			<field name="sequence">50</field>
        	<field name="implied_ids" eval="[(4, ref('pixel_custom_changes.group_department_business'))]"/>
			<field name="privilege_id" ref="res_groups_privilege_departments"/>
        </record>

        <record id="group_partner_business_team" model="res.groups">
            <field name="name">Business Team</field>
        </record>

        <record id="business_team_all_rule" model="ir.rule">
            <field name="name">Contact Business Team</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[Command.link(ref('pixel_custom_changes.group_partner_business_team'))]"/>
        </record>

        <record id="contact_access_rule" model="ir.rule">
            <field name="name">Contact Access</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', ('access_user_ids', 'in', user.ids), ('id', 'in', user.partner_access_ids.ids + [2])]</field>
			<field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

		<function model="ir.model.data" name="write">
			<value model="ir.model.data" search="[('module', '=', 'hr_payroll'), ('name', '=', 'group_hr_payroll_user')]"/>
			<value eval="{'noupdate': False}"/>
		</function>

		<record id="hr_payroll.group_hr_payroll_user" model="res.groups">
			<field name="name">User</field>
			<field name="sequence">10</field>
			<field name="comment">User can manage own contracts, work entries and create payslips.</field>
		</record>

		<record id="group_hr_payroll_only_manager" model="res.groups">
			<field name="name">Officer: Manage all contracts</field>
			<field name="sequence">15</field>
			<field name="privilege_id" ref="hr_payroll.res_groups_privilege_payroll"/>
			<field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
			<field name="comment">User can manage all contracts, work entries and create payslips.</field>
		</record>

		<record id="hr_payroll_rule_officer" model="ir.rule">
			<field name="name">Own Payslip</field>
			<field name="model_id" ref="hr_payroll.model_hr_payslip"/>
			<field name="domain_force">[('employee_id', 'in', user.employee_ids.ids)]</field>
			<field name="groups"
		           eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
		</record>

		<record id="hr_payslip_rule_manage" model="ir.rule">
			<field name="name">Officer and subordinates Payslip</field>
			<field name="model_id" ref="hr_payroll.model_hr_payslip"/>
			<field name="domain_force">[(1, '=', 1)]</field>
			<field name="groups"
		           eval="[(4, ref('pixel_custom_changes.group_hr_payroll_only_manager'))]"/>
		</record>

		<record id="group_hr_holidays_only_user" model="res.groups">
			<field name="name">User</field>
			<field name="sequence">5</field>
			<field name="privilege_id" ref="hr_holidays.res_groups_privilege_time_off"/>
		</record>

    </data>
</openerp>