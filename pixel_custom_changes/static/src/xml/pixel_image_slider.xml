<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pixel_image_slider.PixelImageSliderField" owl="1">
        <div class="pixel_image_slider_container" t-att-class="props.className">
            <div t-if="images.length > 0" class="pixel_slider_wrapper">
                <div class="pixel_slider_viewport">
                    <div class="pixel_slider_track" t-attf-style="transform: translateX(-#{state.currentIndex * 100}%);">
                        <t t-foreach="images" t-as="image" t-key="image.id">
                            <div class="pixel_slider_item">
                                <img t-att-src="getImageUrl(image)" class="pixel_slider_img" t-on-click="() => this.onImageClick(image)"/>
                            </div>
                        </t>
                    </div>
                </div>
                
                <t t-if="images.length > 1">
                    <button class="pixel_slider_prev" t-on-click.stop="prevImage">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <button class="pixel_slider_next" t-on-click.stop="nextImage">
                        <i class="fa fa-chevron-right"/>
                    </button>
                    
                    <div class="pixel_slider_indicators">
                        <t t-foreach="images" t-as="image" t-key="'dot-' + image.id">
                            <span class="pixel_slider_dot" t-att-class="{'active': state.currentIndex === image_index}" t-on-click.stop="() => this.goToImage(image_index)"/>
                        </t>
                    </div>
                </t>
            </div>
            <div t-else="" class="pixel_slider_empty">
                <span>No images to display. Upload images in the ' Manage Images ' tab.</span>
            </div>
        </div>
    </t>
</templates>
